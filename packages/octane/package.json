    "@octanejs/testing-library": "^0.1.66",
    "@testing-library/dom": "^10.4.1",
    "@tsrx/oxc": "0.20.0",
    "@tsrx/typescript-plugin": "^0.6.3",
    "@typed-grid-areas/acceptance": "*",
    "@types/node": "^22.10.5",
    "@vitest/browser-playwright": "^5.0.1",
    "octane": "~0.16.3",
    "playwright": "^1.64.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
