{
  "name": "@typed-grid-areas/octane",
  "version": "0.0.0",
  "description": "Octane adapter for typed-grid-areas (experimental): render a grid definition as typed slot components.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBuss/typed-grid-areas.git",
    "directory": "packages/octane"
  },
  "homepage": "https://github.com/MichaelBuss/typed-grid-areas#readme",
  "bugs": {
    "url": "https://github.com/MichaelBuss/typed-grid-areas/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/gridComponent.tsx"
  ],
  "octane": {
    "source": true
  },
  "scripts": {
