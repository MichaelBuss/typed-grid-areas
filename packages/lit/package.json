{
  "name": "@typed-grid-areas/lit",
  "version": "0.1.1",
  "description": "Lit adapter for typed-grid-areas: render a grid definition as a typed template function.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBuss/typed-grid-areas.git",
    "directory": "packages/lit"
  },
  "homepage": "https://github.com/MichaelBuss/typed-grid-areas#readme",
  "bugs": {
    "url": "https://github.com/MichaelBuss/typed-grid-areas/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && cp ../../README.md ../../LICENSE .",
    "postpack": "rm README.md LICENSE",
    "test": "vitest run --project unit --project node",
    "test:browser": "vitest run --project browser --project browser-development",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "dependencies": {
    "typed-grid-areas": "^0.3.0"
  },
  "devDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "@typed-grid-areas/acceptance": "*",
    "@types/node": "^22.10.5",
    "@vitest/browser-playwright": "^5.0.1",
    "lit": "^3.3.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
