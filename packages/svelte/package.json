{
  "name": "@typed-grid-areas/svelte",
  "version": "0.1.1",
  "description": "Svelte adapter for typed-grid-areas: render a grid definition as typed slot components.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBuss/typed-grid-areas.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/MichaelBuss/typed-grid-areas#readme",
  "bugs": {
    "url": "https://github.com/MichaelBuss/typed-grid-areas/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "buildSources": {
    "dist": [
      "src/lib"
    ]
  },
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "prepack": "npm run build 1>&2 && cp ../../README.md ../../LICENSE .",
    "postpack": "rm README.md LICENSE",
    "test": "vitest run --project unit --project node",
    "test:browser": "vitest run --project browser --project browser-development",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "dependencies": {
    "esm-env": "^1.2.2",
    "typed-grid-areas": "^0.3.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@typed-grid-areas/acceptance": "*",
    "@types/node": "^22.10.5",
    "@vitest/browser-playwright": "^5.0.1",
    "playwright": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.1",
    "vitest-browser-svelte": "^3.1.0"
  }
}
