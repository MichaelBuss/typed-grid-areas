{
  "name": "@typed-grid-areas/site",
  "version": "0.0.0",
  "private": true,
  "description": "The docs site (Astro Starlight), deployed to GitHub Pages after each release. Never published.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build -w @typed-grid-areas/react && astro dev",
    "build": "npm run build -w @typed-grid-areas/react && astro build",
    "preview": "astro preview",
    "test": "vitest run --project node",
    "test:browser": "npm run build && vitest run --project browser",
    "typecheck": "npm run build -w @typed-grid-areas/react && astro check && tsc --noEmit"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.8",
    "@typed-grid-areas/acceptance": "*",
    "@typed-grid-areas/react": "*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "github-slugger": "^2.0.0",
    "playwright": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typed-grid-areas": "*",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
