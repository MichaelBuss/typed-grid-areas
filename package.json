{
  "name": "typed-grid-areas-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/core",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build -w typed-grid-areas",
    "test": "npm run build:core && vitest run && npm run test --workspaces --if-present",
    "test:browser": "npm run build:core && npm run test:browser --workspaces --if-present",
    "typecheck": "npm run build:core && tsc --noEmit && npm run typecheck --workspaces --if-present",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-version.ts",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.10.5",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "octane": {
      "typescript": "$typescript"
    },
    "vitest-browser-preact": {
      "preact": "^11.0.0"
    }
  }
}
