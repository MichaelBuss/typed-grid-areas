{
  "name": "typed-grid-areas",
  "version": "0.1.0",
  "private": true,
  "description": "Type-safe CSS grid-template-areas with automatic :has() selector generation.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser --project browser-development",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.64.1",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
