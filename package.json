{
  "name": "typed-grid-areas",
  "version": "0.1.0",
  "description": "Type-safe CSS grid-template-areas with automatic :has() selector generation.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelBuss/typed-grid-areas.git"
  },
  "homepage": "https://github.com/MichaelBuss/typed-grid-areas#readme",
  "bugs": {
    "url": "https://github.com/MichaelBuss/typed-grid-areas/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run --project unit --project node",
    "test:browser": "vitest run --project browser --project browser-development",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-version.ts",
    "release": "node scripts/release.ts"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.1",
    "happy-dom": "^20.14.5",
    "playwright": "^1.64.1",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "vitest-browser-react": "^2.3.0"
  }
}
